{
  "name": "ds-ui",
  "version": "0.1.0",
  "description": "A Vue 3 component library built on Naive UI — schema-driven forms, filterable tables, and modal/drawer primitives.",
  "type": "module",
  "license": "MIT",
  "author": "Wwb15617964957",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwb-xigua/ds-ui.git"
  },
  "homepage": "https://wwb-xigua/ds-ui#readme",
  "bugs": {
    "url": "https://github.com/wwb-xigua/ds-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "components",
    "ui",
    "naive-ui",
    "typescript",
    "form",
    "table",
    "admin"
  ],
  "main": "./dist/ds-ui.cjs",
  "module": "./dist/ds-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ds-ui.js",
      "require": "./dist/ds-ui.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:docs": "vitepress dev docs",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "build:docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "preview": "vite preview",
    "format": "prettier --write \"packages/**/*.{ts,vue}\" \"playground/**/*.{ts,vue}\" \"docs/**/*.{ts,md}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"packages/**/*.{ts,vue}\" \"playground/**/*.{ts,vue}\" \"docs/**/*.{ts,md}\" \"scripts/*.mjs\"",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "date-fns": "^3.6.0",
    "naive-ui": "^2.40.4",
    "vue-draggable-next": "^2.2.1",
    "vue-types": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "less": "^4.1.3",
    "naive-ui": "^2.40.4",
    "prettier": "3.0.2",
    "typescript": "^5.0.2",
    "vite": "^4.5.3",
    "vite-plugin-dts": "^3.5.1",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "^1.6.4",
    "vue": "^3.4.30",
    "vue-tsc": "^3.0.1"
  }
}
